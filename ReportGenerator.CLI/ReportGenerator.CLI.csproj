<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <RootNamespace>ReportGenerator.CLI</RootNamespace>
    <AssemblyName>ReportGenerator.CLI</AssemblyName>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportGenerator.Services\ReportGenerator.Services.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)content&quot; &quot;$(TargetDir)content&quot; /e /y /i /r" />
  </Target>

</Project>
